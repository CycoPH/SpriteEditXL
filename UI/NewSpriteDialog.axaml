<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SpriteEditXL.UI.NewSpriteDialog"
        Title="New sprite"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="Pick a sprite layout to start with:"
                   FontWeight="Bold"/>
        <ListBox x:Name="TemplateList" MinHeight="220"/>
        <TextBlock x:Name="DescTb" TextWrapping="Wrap"
                   FontFamily="Cascadia Mono, Consolas, monospace"
                   FontSize="11"/>
        <StackPanel Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OkBtn" Content="Create" Width="100"
                    IsDefault="True"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
            <Button x:Name="CancelBtn" Content="Cancel" Width="100"
                    IsCancel="True"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</Window>
